# All of Tasmania (main island incl. Bruny, Maria Island, Tasman Peninsula) up to zoom 17,
# everything twice as large (MAGNIFY=2), tracks variant C, LIST hillshade, both overlays.
# The map is published in parts below 2 GB ("...-partNofM.mbtiles"), the app shows them as one map.
NAME=tasmania-z17
TITLE="Tasmanien (bis Zoom 17)"
BBOX=144.55,-43.70,148.40,-40.60
MINZOOM=0
MAXZOOM=17
MAGNIFY=2
# wilderness (more than 2 km from a road and not along a path of a day walk) only up to zoom 15
WILD_MAXZOOM=15
EARLY_TRAILS=2
GITHUB_SHARDS=40
PBF_URLS="https://download.geofabrik.de/australia-oceania/australia-latest.osm.pbf"
TASVEG=1
LIST_TRACKS=C
LIST_HILLSHADE=1
OVERLAYS="walks walkability"
# hatching up to zoom 15 (z16/17 would be ~4 GB); the app enlarges it beyond
OVERLAY_MAXZOOM_walkability=15
# roads and tracks from LIST and OSM (each drawn once), rivers, lakes and contours from LIST
LIST_PLUS=1
LIST_HYDRO=1
LIST_CONTOURS=1
# run 2: faster LIST road matching for the whole state
# Only the walks overlay again (base map and walkability stay those of map-43-komplett): uncomment both lines
# ONLY_OVERLAYS="walks"
# GITHUB_SHARDS=10
# access overlay from LIST land tenure (map-44 has the walks overlay): only this one, up to zoom 15
# ONLY_OVERLAYS="tenure"   (published as map-45)
OVERLAY_MAXZOOM_tenure=15
# GITHUB_SHARDS=10
